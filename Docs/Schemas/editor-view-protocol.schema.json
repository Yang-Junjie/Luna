{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luna.local/schemas/editor-view-protocol.schema.json",
  "title": "Luna Editor View Protocol",
  "oneOf": [
    { "$ref": "#/$defs/viewportCommandEnvelope" },
    { "$ref": "#/$defs/viewportStateEnvelope" },
    { "$ref": "#/$defs/viewportResponseEnvelope" }
  ],
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "luna.editor" },
        "version": { "const": 1 }
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "viewportSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "$ref": "#/$defs/nonNegativeInteger" },
        "height": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "viewportKind": {
      "enum": ["scene", "debug", "preview", "custom"]
    },
    "transformTool": {
      "enum": ["translate", "rotate", "scale"]
    },
    "transformSpace": {
      "enum": ["local", "world"]
    },
    "debugViewMode": {
      "enum": [
        "none",
        "velocity",
        "historyValidity",
        "shadowCascades",
        "baseColor",
        "normal",
        "metallic",
        "roughness",
        "directLighting",
        "specularIbl",
        "bloomInput",
        "bloomPrefilter",
        "bloomMip0",
        "bloomMip1",
        "bloomMip2",
        "bloomMip3",
        "bloomMip4",
        "bloomMip5",
        "bloomComposite"
      ]
    },
    "cameraState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "position",
        "orientationEulerRadians",
        "perspectiveVerticalFovRadians",
        "perspectiveNear",
        "perspectiveFar",
        "orthographicSize",
        "orthographicNear",
        "orthographicFar"
      ],
      "properties": {
        "projection": { "enum": ["perspective", "orthographic"] },
        "position": { "$ref": "#/$defs/vec3" },
        "orientationEulerRadians": { "$ref": "#/$defs/vec3" },
        "perspectiveVerticalFovRadians": { "type": "number" },
        "perspectiveNear": { "type": "number" },
        "perspectiveFar": { "type": "number" },
        "orthographicSize": { "type": "number" },
        "orthographicNear": { "type": "number" },
        "orthographicFar": { "type": "number" }
      }
    },
    "interactionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible",
        "focused",
        "hovered",
        "inputEnabled",
        "mouseCaptured",
        "runtimeViewport",
        "pickDebugEnabled"
      ],
      "properties": {
        "visible": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "hovered": { "type": "boolean" },
        "inputEnabled": { "type": "boolean" },
        "mouseCaptured": { "type": "boolean" },
        "runtimeViewport": { "type": "boolean" },
        "pickDebugEnabled": { "type": "boolean" }
      }
    },
    "renderPlaneKind": {
      "enum": ["sceneViewport", "debugViewport", "preview", "capture"]
    },
    "renderTransportKind": {
      "enum": ["none", "nativeSurface", "sharedTexture", "cpuImage"]
    },
    "renderPlaneDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planeId",
        "viewportId",
        "kind",
        "transport",
        "format",
        "width",
        "height",
        "yFlip",
        "presentable",
        "generation",
        "bindingToken",
        "label"
      ],
      "properties": {
        "planeId": { "$ref": "#/$defs/nonNegativeInteger" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "kind": { "$ref": "#/$defs/renderPlaneKind" },
        "transport": { "$ref": "#/$defs/renderTransportKind" },
        "format": { "type": "string" },
        "width": { "$ref": "#/$defs/nonNegativeInteger" },
        "height": { "$ref": "#/$defs/nonNegativeInteger" },
        "yFlip": { "type": "boolean" },
        "presentable": { "type": "boolean" },
        "generation": { "$ref": "#/$defs/nonNegativeInteger" },
        "bindingToken": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "renderFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameId",
        "planeId",
        "sequence",
        "timestampNs",
        "width",
        "height",
        "ready"
      ],
      "properties": {
        "frameId": { "$ref": "#/$defs/nonNegativeInteger" },
        "planeId": { "$ref": "#/$defs/nonNegativeInteger" },
        "sequence": { "$ref": "#/$defs/nonNegativeInteger" },
        "timestampNs": { "$ref": "#/$defs/nonNegativeInteger" },
        "width": { "$ref": "#/$defs/nonNegativeInteger" },
        "height": { "$ref": "#/$defs/nonNegativeInteger" },
        "ready": { "type": "boolean" }
      }
    },
    "renderPlaneState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "frame", "active"],
      "properties": {
        "descriptor": { "$ref": "#/$defs/renderPlaneDescriptor" },
        "frame": { "$ref": "#/$defs/renderFrame" },
        "active": { "type": "boolean" }
      }
    },
    "viewportState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewportId",
        "title",
        "kind",
        "size",
        "camera",
        "interaction",
        "transformTool",
        "transformSpace",
        "debugViewMode",
        "debugVelocityScale",
        "renderPlane"
      ],
      "properties": {
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "title": { "type": "string" },
        "kind": { "$ref": "#/$defs/viewportKind" },
        "size": { "$ref": "#/$defs/viewportSize" },
        "camera": { "$ref": "#/$defs/cameraState" },
        "interaction": { "$ref": "#/$defs/interactionState" },
        "transformTool": { "$ref": "#/$defs/transformTool" },
        "transformSpace": { "$ref": "#/$defs/transformSpace" },
        "debugViewMode": { "$ref": "#/$defs/debugViewMode" },
        "debugVelocityScale": { "type": "number" },
        "renderPlane": { "$ref": "#/$defs/renderPlaneState" }
      }
    },
    "viewportCommand": {
      "oneOf": [
        { "$ref": "#/$defs/createViewportCommand" },
        { "$ref": "#/$defs/destroyViewportCommand" },
        { "$ref": "#/$defs/resizeViewportCommand" },
        { "$ref": "#/$defs/setCameraCommand" },
        { "$ref": "#/$defs/setInteractionStateCommand" },
        { "$ref": "#/$defs/setTransformStateCommand" },
        { "$ref": "#/$defs/setDebugViewModeCommand" },
        { "$ref": "#/$defs/setDebugVelocityScaleCommand" },
        { "$ref": "#/$defs/requestPickCommand" },
        { "$ref": "#/$defs/captureFrameCommand" }
      ]
    },
    "createViewportCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "viewportId",
        "title",
        "viewportKind",
        "size",
        "camera",
        "interaction",
        "transformTool",
        "transformSpace",
        "debugViewMode",
        "debugVelocityScale"
      ],
      "properties": {
        "kind": { "const": "createViewport" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "title": { "type": "string" },
        "viewportKind": { "$ref": "#/$defs/viewportKind" },
        "size": { "$ref": "#/$defs/viewportSize" },
        "camera": { "$ref": "#/$defs/cameraState" },
        "interaction": { "$ref": "#/$defs/interactionState" },
        "transformTool": { "$ref": "#/$defs/transformTool" },
        "transformSpace": { "$ref": "#/$defs/transformSpace" },
        "debugViewMode": { "$ref": "#/$defs/debugViewMode" },
        "debugVelocityScale": { "type": "number" }
      }
    },
    "destroyViewportCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId"],
      "properties": {
        "kind": { "const": "destroyViewport" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "resizeViewportCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "size"],
      "properties": {
        "kind": { "const": "resizeViewport" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "size": { "$ref": "#/$defs/viewportSize" }
      }
    },
    "setCameraCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "camera"],
      "properties": {
        "kind": { "const": "setCamera" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "camera": { "$ref": "#/$defs/cameraState" }
      }
    },
    "setInteractionStateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "interaction"],
      "properties": {
        "kind": { "const": "setInteractionState" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "interaction": { "$ref": "#/$defs/interactionState" }
      }
    },
    "setTransformStateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "transformTool", "transformSpace"],
      "properties": {
        "kind": { "const": "setTransformState" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "transformTool": { "$ref": "#/$defs/transformTool" },
        "transformSpace": { "$ref": "#/$defs/transformSpace" }
      }
    },
    "setDebugViewModeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "debugViewMode"],
      "properties": {
        "kind": { "const": "setDebugViewMode" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "debugViewMode": { "$ref": "#/$defs/debugViewMode" }
      }
    },
    "setDebugVelocityScaleCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "debugVelocityScale"],
      "properties": {
        "kind": { "const": "setDebugVelocityScale" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "debugVelocityScale": { "type": "number" }
      }
    },
    "requestPickCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId", "pickX", "pickY"],
      "properties": {
        "kind": { "const": "requestPick" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" },
        "pickX": { "$ref": "#/$defs/nonNegativeInteger" },
        "pickY": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "captureFrameCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "viewportId"],
      "properties": {
        "kind": { "const": "captureFrame" },
        "viewportId": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "viewportCommandEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "command"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "command": { "$ref": "#/$defs/viewportCommand" }
      }
    },
    "viewportStateEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "state"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "state": { "$ref": "#/$defs/viewportState" }
      }
    },
    "viewportResponseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "accepted",
        "changed",
        "requestPick",
        "requestCapture",
        "state"
      ],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "accepted": { "type": "boolean" },
        "changed": { "type": "boolean" },
        "requestPick": { "type": "boolean" },
        "requestCapture": { "type": "boolean" },
        "state": { "$ref": "#/$defs/viewportState" }
      }
    }
  }
}
